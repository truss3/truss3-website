---
import Logo from './Logo.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a class="brand" href={base} aria-label={`${SITE.name} 首页`}>
          <Logo />
          <span class="brand-name">{SITE.name}</span>
        </a>
        <p class="footer-company">{SITE.company}</p>
      </div>

      <nav class="footer-nav" aria-label="页脚导航">
        <ul>
          {SITE.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-meta">
      <ul class="footer-contact">
        <li>
          <span class="footer-label">电话</span>
          <a href={`tel:${SITE.contact.phone}`}>{SITE.contact.phone}</a>
        </li>
        <li>
          <span class="footer-label">邮箱</span>
          <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
        </li>
      </ul>

      <p class="footer-legal">
        <span>
          © {year} {SITE.company}
        </span>
        <a href={SITE.icp.url} target="_blank" rel="noopener noreferrer">
          {SITE.icp.number}
        </a>
      </p>
    </div>
  </div>
</footer>
