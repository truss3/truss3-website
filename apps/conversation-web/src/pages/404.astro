---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="页面不存在" description="抱歉，你访问的页面不存在。">
  <main id="main" class="notfound">
    <p class="eyebrow">404</p>
    <h1>页面不存在</h1>
    <p>你访问的地址可能已被移动或删除。</p>
    <a class="btn btn-primary" href={base}>
      返回首页
    </a>
  </main>
</Layout>
